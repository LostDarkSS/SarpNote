<Window x:Class="SarpNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SarpNote" 
        WindowStyle="None"
        AllowsTransparency="False"
        BorderBrush="#1E2230"
        BorderThickness="0"
        Height="920" Width="1560" WindowState="Maximized"
        Background="#0B0C10" Foreground="#F4F4F6"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown" AllowDrop="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- SETTINGS CUSTOM STYLES -->
        <Style x:Key="SettingsNavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="12,0">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="1.5" Background="#818CF8" HorizontalAlignment="Left" Margin="-12,0,0,0" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#181D2E"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="#1E243B"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="StateLbl" Text="Kapalı" Foreground="#64748B" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" Background="#252B40" BorderBrush="#333B57" BorderThickness="1">
                                <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9" Background="#94A3B8" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                    </Border.Effect>
                                </Border>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#4F46E5"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#818CF8"/>
                                <Setter TargetName="Thumb" Property="Background" Value="White"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="StateLbl" Property="Text" Value="Aktif"/>
                                <Setter TargetName="StateLbl" Property="Foreground" Value="#A5B4FC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#23293E" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="#6366F1"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Knob" Fill="#F8FAFC" Stroke="#6366F1" StrokeThickness="2.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#6366F1" BlurRadius="8" ShadowDepth="0" Opacity="0.55"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="Stroke" Value="#A5B4FC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Background" Value="#131724"/>
            <Setter Property="BorderBrush" Value="#2E3652"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Box" Background="#131724" BorderBrush="#2E3652" BorderThickness="1" CornerRadius="8" Padding="12,0,10,0">
                                            <Grid>
                                                <Path Data="M 0,0 L 4.5,4.5 L 9,0" Stroke="#94A3B8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="#6366F1"/>
                                                <Setter TargetName="Box" Property="Background" Value="#1A2033"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border Margin="12,0,30,0" ClipToBounds="True" IsHitTestVisible="False"><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center" HorizontalAlignment="Left"/></Border>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}" Background="#161B2B" BorderBrush="#333C5C" BorderThickness="1" CornerRadius="8" Padding="4">
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#1D2336"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2F3854"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#27304A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#161B2B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCloseBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" Width="32" Height="32" CornerRadius="16" Background="#1A1F30" BorderBrush="#2A314A" BorderThickness="1">
                            <Path Data="M 11,11 L 21,21 M 21,11 L 11,21" Stroke="#94A3B8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#3B1D2A"/>
                                <Setter TargetName="Circle" Property="BorderBrush" Value="#F43F5E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- END SETTINGS STYLES -->
        <Style x:Key="DockIconBtn" TargetType="Button">
            <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#25293C"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.30"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopGhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,3"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#25293B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DRAWBOARD ACIK TEMA DASHBOARD SOL MENU BUTONU -->
        <Style x:Key="LightNavBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DRAWBOARD ACIK TEMA GHOST BUTON -->
        <Style x:Key="LightGhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,4"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="#1E202B"/><Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="#6366F1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SquareColorSwatch" TargetType="Button">
            <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="Margin" Value="2.5,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="swatch" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="swatch" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PenModeCard" TargetType="Button">
            <Setter Property="Width" Value="88"/><Setter Property="Height" Value="74"/><Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#232631"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1.5"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThumbnailListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="4,5"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="card" Background="#161822" BorderBrush="#262A3B" BorderThickness="1.5" CornerRadius="8" Padding="5">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="#EF4444"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
            <Style x:Key="ModernStudioSlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="#2D3244" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#6366F1" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#FFFFFF" Stroke="#6366F1" StrokeThickness="2.2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
            <!-- MODERN INCE YUVARLATILMIS KAYDIRMA CUBUGU -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Margin" Value="2,4,2,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="GridRoot" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBorder" Background="#3A4056" CornerRadius="3" Width="4" HorizontalAlignment="Center"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#6366F1"/>
                                                        <Setter TargetName="ThumbBorder" Property="Width" Value="5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#818CF8"/>
                                                        <Setter TargetName="ThumbBorder" Property="Width" Value="5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootWindowGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- KOYU UST SEKME CUBUGU (DRAWBOARD UST SERIT) -->
        <Border x:Name="TopTitleBarBorder" Grid.Row="0" Background="#1E2029" BorderBrush="#282B37" BorderThickness="0,0,0,1" PreviewMouseLeftButtonDown="TopBar_PreviewMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,6,0">
                    <!-- SOL UST ANA MENU BUTONU -->
                    <Button x:Name="BtnHomeDashboard" Width="34" Height="30" ClickMode="Press" Focusable="False"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Cursor="Hand" ToolTip="SarpNote Kitaplık ve Dosya Yöneticisi"
                            Click="BtnHomeDashboard_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="34" Height="30" Background="Transparent">
                                    <Border x:Name="LogoBd" Width="28" Height="24" CornerRadius="7" Background="#0F172A" BorderBrush="#6366F1" BorderThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-0.5,0,0" IsHitTestVisible="False">
                                            <TextBlock Text="S" Foreground="#F8FAFC" FontSize="11.5" FontWeight="ExtraBold" FontFamily="Segoe UI" IsHitTestVisible="False"/>
                                            <TextBlock Text="N" Foreground="#38BDF8" FontSize="11.5" FontWeight="ExtraBold" FontFamily="Segoe UI" Margin="0.5,0,0,0" IsHitTestVisible="False"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="LogoBd" Property="Background" Value="#1E293B"/>
                                        <Setter TargetName="LogoBd" Property="BorderBrush" Value="#38BDF8"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="LogoBd" Property="Background" Value="#312E81"/>
                                        <Setter TargetName="LogoBd" Property="BorderBrush" Value="#818CF8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnTopSettings" ClickMode="Press" WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TopGhostBtn}" Width="30" Height="28" Margin="4,0,2,0" ToolTip="Ayarlar ve Motor Yapılandırması (F2)" Click="BtnOpenSettings_Click">
                        <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Fill="#CBD5E1" Stretch="Uniform" Width="14" Height="14"/>
                    </Button>
                    <Button x:Name="BtnPaperSettings" ClickMode="Press" WindowChrome.IsHitTestVisibleInChrome="True" Width="30" Height="28" Margin="4,0,2,0" Style="{StaticResource TopGhostBtn}" ToolTip="Ek Çözüm Kağıdı Ayarları" Click="BtnPaperSettings_Click">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="3" Canvas.Top="3" Width="11" Height="18" RadiusX="2" RadiusY="2" Stroke="#CBD5E1" StrokeThickness="1.7" Fill="Transparent"/>
                                <Border Canvas.Left="15" Canvas.Top="3" Width="6" Height="18" CornerRadius="0,2,2,0" BorderBrush="#818CF8" BorderThickness="1.6" Background="#266366F1"/>
                                <Line X1="15" Y1="8" X2="21" Y2="8" Stroke="#818CF8" StrokeThickness="1.2"/>
                                <Line X1="15" Y1="13" X2="21" Y2="13" Stroke="#818CF8" StrokeThickness="1.2"/>
                                <Line X1="15" Y1="18" X2="21" Y2="18" Stroke="#818CF8" StrokeThickness="1.2"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <!-- ACIK PDF SEKMELERI + TAM ORTALANMIS KUCUK (+) TUSU -->
                <ScrollViewer Grid.Column="1" Background="Transparent" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                        <StackPanel x:Name="OpenTabsPanel" Orientation="Horizontal" VerticalAlignment="Bottom"/>
                        <Button x:Name="BtnNewTabPlus" Width="26" Height="26" Margin="6,0,0,0" VerticalAlignment="Center" ClickMode="Press" Focusable="False"
                                WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" ToolTip="Yeni PDF Aç / Kitaplık" Click="BtnHomeDashboard_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Canvas Width="26" Height="26" Background="Transparent" UseLayoutRounding="False" SnapsToDevicePixels="False">
                                        <Ellipse x:Name="Circle" Canvas.Left="0" Canvas.Top="0" Width="26" Height="26" Fill="#1E2231" Stroke="#2E344B" StrokeThickness="1.2"/>
                                        <Line X1="8" Y1="13" X2="18" Y2="13" Stroke="#F1F5F9" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
                                        <Line X1="13" Y1="8" X2="13" Y2="18" Stroke="#F1F5F9" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
                                    </Canvas>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Circle" Property="Fill" Value="#2A3046"/>
                                            <Setter TargetName="Circle" Property="Stroke" Value="#6366F1"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Circle" Property="Fill" Value="#312E81"/>
                                            <Setter TargetName="Circle" Property="Stroke" Value="#818CF8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

            <!-- SAG UST PENCERE KONTROL TUSLARI -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,6,0">
                    <Button Width="28" Height="26" Style="{StaticResource TopGhostBtn}" Click="BtnWinMinimize_Click" ToolTip="Küçült">
                        <Canvas Width="12" Height="12"><Line X1="2" Y1="6" X2="10" Y2="6" Stroke="#94A3B8" StrokeThickness="1.5"/></Canvas>
                    </Button>
                    <Button x:Name="BtnWinMax" Width="28" Height="26" Style="{StaticResource TopGhostBtn}" Click="BtnWinMaximize_Click" ToolTip="Tam Ekran / Küçült">
                        <Canvas Width="12" Height="12"><Path x:Name="WinMaxRestorePath" Stroke="#94A3B8" StrokeThickness="1.3" Data="M 1.5,3.5 L 8.5,3.5 L 8.5,10.5 L 1.5,10.5 Z M 3.5,3.5 L 3.5,1.5 L 10.5,1.5 L 10.5,8.5 L 8.5,8.5"/></Canvas>
                    </Button>
                    <Button Width="28" Height="26" Style="{StaticResource TopGhostBtn}" Click="BtnWinClose_Click" ToolTip="Kapat">
                        <Canvas Width="12" Height="12"><Path Stroke="#F87171" StrokeThickness="1.5" Data="M 2.5,2.5 L 9.5,9.5 M 9.5,2.5 L 2.5,9.5"/></Canvas>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ANA ICERIK ALANI -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition x:Name="PagesDrawerColumn" Width="158"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL INCE DIKEY GEZINME SERIDI -->
            <Border Grid.Column="0" Background="#14161F" BorderBrush="#1C1F2E" BorderThickness="0,0,1,0" Padding="0,8">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <Button x:Name="BtnTogglePagesDrawer" Width="32" Height="32" Style="{StaticResource DockIconBtn}" Background="#23273A" BorderBrush="#6366F1" Click="BtnTogglePagesDrawer_Click" ToolTip="Sayfa Önizlemeleri">
                        <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Rectangle Canvas.Left="3" Canvas.Top="4" Width="7" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="#6366F1" Stroke="#E2E8F0" StrokeThickness="1.5"/><Rectangle Canvas.Left="13" Canvas.Top="4" Width="8" Height="7" RadiusX="1.5" RadiusY="1.5" Stroke="#94A3B8" StrokeThickness="1.5"/><Rectangle Canvas.Left="13" Canvas.Top="13" Width="8" Height="7" RadiusX="1.5" RadiusY="1.5" Stroke="#94A3B8" StrokeThickness="1.5"/></Canvas></Viewbox>
                    </Button>
                    <Button x:Name="BtnFilterStarredPages" Width="32" Height="32" Margin="0,4" Style="{StaticResource DockIconBtn}" Click="BtnFilterStarredPages_Click" ToolTip="Yıldızlı Sayfaları Filtrele">
                        <Path x:Name="LeftStarFilterPath" Width="16" Height="16" Stretch="Uniform" Stroke="#FACC15" StrokeThickness="1.7" Fill="Transparent" Data="M 12,2.5 L 14.9,8.4 L 21.4,9.3 L 16.7,13.9 L 17.8,20.4 L 12,17.3 L 6.2,20.4 L 7.3,13.9 L 2.6,9.3 L 9.1,8.4 Z"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- SOL SAYFA ONIZLEME CEKMECESI -->
            <Border Grid.Column="1" Background="#151721" BorderBrush="#1F2333" BorderThickness="0,0,1,0">
                <Grid>
        <Grid.RowDefinitions>
                        <RowDefinition Height="32"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtPagesHeader" Grid.Row="0" Text="Pages" FontSize="12" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="10,0"/>
                    <ListBox x:Name="ThumbnailList" Grid.Row="1" Style="{StaticResource ThumbnailListStyle}" SelectionChanged="ThumbnailList_SelectionChanged" ScrollViewer.ScrollChanged="ThumbnailList_ScrollChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="122" Margin="0,2">
                                    <Border Background="#FFFFFF" CornerRadius="4" Height="162" ClipToBounds="True">
                                        <Image Source="{Binding ThumbnailSource}" Stretch="Uniform"/>
                                    </Border>
                                    <Border Background="#D90F172A" CornerRadius="6" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Visibility="{Binding StarVisibility}">
                                        <TextBlock Text="★" Foreground="#FACC15" FontSize="10"/>
                                    </Border>
                                    <Border Background="#E611131C" BorderBrush="#334155" BorderThickness="0" CornerRadius="8" Padding="6,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4">
                                        <TextBlock Text="{Binding PageNumberText}" Foreground="#F8FAFC" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- PDF CALISMA TUVALI -->
            <Grid x:Name="WorkspaceGrid" Grid.Column="2" Background="#0B0C10" ClipToBounds="True">
                <ScrollViewer x:Name="MainScroll" BorderThickness="0" Background="Transparent"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                              CanContentScroll="False" Padding="0,4"
                              ScrollChanged="MainScroll_ScrollChanged"
                              PreviewMouseWheel="MainScroll_PreviewMouseWheel">
                    <StackPanel x:Name="PagesStack" HorizontalAlignment="Center" VerticalAlignment="Top" Background="Transparent">
                        <StackPanel.LayoutTransform>
                            <ScaleTransform x:Name="PageScale" ScaleX="1.0" ScaleY="1.0"/>
                        </StackPanel.LayoutTransform>
                    </StackPanel>
                </ScrollViewer>

                <!-- KAGIT AYARI -->
                <Border x:Name="PaperSettingsPopup" Width="304" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,10,0,0" Panel.ZIndex="8500"
                        Background="#F5131726" BorderBrush="#2E3654" BorderThickness="1.3" CornerRadius="16" Padding="16,14" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.78"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Kart Ust Basligi -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="#1E2542" BorderBrush="#6366F1" BorderThickness="1" Margin="0,0,10,0">
                                <Viewbox Width="14" Height="14">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="3" Canvas.Top="3" Width="11" Height="18" RadiusX="2" RadiusY="2" Stroke="#E2E8F0" StrokeThickness="1.8"/>
                                        <Rectangle Canvas.Left="15" Canvas.Top="3" Width="6" Height="18" RadiusX="1.5" RadiusY="1.5" Stroke="#818CF8" StrokeThickness="1.8" Fill="#4D6366F1"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Ek Çözüm Kağıdı" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="Desen, kağıt rengi ve boyut ayarları" Foreground="#64748B" FontSize="10.5"/>
                            </StackPanel>
                            <Button Grid.Column="2" Width="24" Height="24" Style="{StaticResource TopGhostBtn}" Click="BtnPaperSettings_Click" ToolTip="Kapat">
                                <Path Stroke="#94A3B8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 3,3 L 11,11 M 11,3 L 3,11"/>
                            </Button>
                        </Grid>

                        <!-- Aktif / Pasif Anahtar Karti -->
                        <Border Background="#181D2E" BorderBrush="#262E48" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Sağ Çözüm Kağıdı Ekle" Foreground="#F1F5F9" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Sayfanın sağında işlem alanı açar" Foreground="#64748B" FontSize="10.5" Margin="0,1,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkExtraMargin" Grid.Column="1" Style="{StaticResource SettingsToggle}" IsChecked="False" VerticalAlignment="Center" Checked="MarginOption_Changed" Unchecked="MarginOption_Changed"/>
                            </Grid>
                        </Border>

                        <!-- Kagit Deseni Secici -->
                        <TextBlock Text="KAĞIT DESENİ" Foreground="#94A3B8" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,6"/>
                        <ComboBox x:Name="CmbPaperStyle" Style="{StaticResource SettingsComboBox}" Height="34" SelectedIndex="0" SelectionChanged="MarginOption_Changed" Margin="0,0,0,12">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="#F1F5F9"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="10,7"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="ItemBd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="#252D47"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="#312E81"/>
                                                        <Setter Property="Foreground" Value="#A5B4FC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBoxItem Content="⊞  Kareli Çözüm Kağıdı"/>
                            <ComboBoxItem Content="∷  Noktalı Çözüm Kağıdı"/>
                            <ComboBoxItem Content="☐  Düz Kağıt"/>
                        </ComboBox>

                        <!-- Kagit Rengi Secici (6 Renk) -->
                        <TextBlock Text="KAĞIT RENGİ" Foreground="#94A3B8" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,6"/>
                        <UniformGrid x:Name="MarginColorSwatchesGrid" Columns="6" Margin="0,0,0,12">
                            <Button Style="{StaticResource SquareColorSwatch}" Width="34" Height="28" Background="#FAFAFC" BorderBrush="#6366F1" Tag="#FAFAFC" Click="MarginColorSwatch_Click" ToolTip="Klasik Beyaz"/>
                            <Button Style="{StaticResource SquareColorSwatch}" Width="34" Height="28" Background="#FDF6E3" Tag="#FDF6E3" Click="MarginColorSwatch_Click" ToolTip="Sıcak Krem / Sepya"/>
                            <Button Style="{StaticResource SquareColorSwatch}" Width="34" Height="28" Background="#FEF9C3" Tag="#FEF9C3" Click="MarginColorSwatch_Click" ToolTip="Not Sarısı"/>
                            <Button Style="{StaticResource SquareColorSwatch}" Width="34" Height="28" Background="#EFF6FF" Tag="#EFF6FF" Click="MarginColorSwatch_Click" ToolTip="Buz Mavisi"/>
                            <Button Style="{StaticResource SquareColorSwatch}" Width="34" Height="28" Background="#ECFDF5" Tag="#ECFDF5" Click="MarginColorSwatch_Click" ToolTip="Nane Yeşili"/>
                            <Button Style="{StaticResource SquareColorSwatch}" Width="34" Height="28" Background="#181B26" Tag="#181B26" Click="MarginColorSwatch_Click" ToolTip="Gece Koyu"/>
                        </UniformGrid>

                        <!-- Kagit Boyutu (Genislik) Ayari -->
                        <Grid Margin="2,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="KAĞIT GENİŞLİĞİ" Foreground="#94A3B8" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#1E2542" BorderBrush="#312E81" BorderThickness="1" CornerRadius="6" Padding="7,2">
                                <TextBlock x:Name="TxtPopupMarginWidth" Text="560 px" Foreground="#A5B4FC" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <Slider x:Name="SliderPopupMarginWidth" Style="{StaticResource SettingsSlider}" Minimum="360" Maximum="840" Value="560" TickFrequency="40" IsSnapToTickEnabled="True" ValueChanged="SliderPopupMarginWidth_Changed"/>
                    </StackPanel>
                </Border>

                <!-- SAG ALT YUZEN ZOOM KAPSULU -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,16"
                        Background="#EB14161F" BorderBrush="#282D3F" BorderThickness="1.2" CornerRadius="12" Padding="6,3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="26" Height="24" Style="{StaticResource TopGhostBtn}" Padding="0" Click="BtnZoomOut_Click" ToolTip="Uzaklaştır">
                            <TextBlock Text="−" FontSize="14" FontWeight="Bold" Foreground="#CBD5E1"/>
                        </Button>
                        <Button x:Name="BtnZoomReset" Height="24" MinWidth="48" Style="{StaticResource TopGhostBtn}" Padding="6,0" Click="BtnZoomReset_Click" ToolTip="Sayfayı Ekrana Sığdır">
                            <TextBlock x:Name="TxtZoom" Text="%130" Foreground="#A5B4FC" FontWeight="Bold" FontSize="11.5"/>
                        </Button>
                        <Button Width="26" Height="24" Style="{StaticResource TopGhostBtn}" Padding="0" Click="BtnZoomIn_Click" ToolTip="Yakınlaştır">
                            <TextBlock Text="＋" FontSize="13" FontWeight="Bold" Foreground="#CBD5E1"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- SAG DIKEY ARAC CUBUGU -->
                <Border x:Name="RightIconDock" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Width="48" Background="#F214161F" BorderBrush="#282D3F" BorderThickness="1.2" CornerRadius="16" Padding="3,8">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <!-- Yıldızla -->
                        <Button x:Name="BtnBookmarkPage" Style="{StaticResource DockIconBtn}" Click="BtnBookmarkPage_Click" ToolTip="Sayfayı Yıldızla">
                            <Viewbox Width="19" Height="19">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="StarIconPath" Stroke="#FACC15" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" Data="M 12,2.5 L 14.9,8.4 L 21.4,9.3 L 16.7,13.9 L 17.8,20.4 L 12,17.3 L 6.2,20.4 L 7.3,13.9 L 2.6,9.3 L 9.1,8.4 Z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Border Height="1" Width="24" Background="#25293A" Margin="0,3"/>

                        <!-- El Aracı (Pan) -->
                        <Button x:Name="BtnPan" Style="{StaticResource DockIconBtn}" PreviewMouseLeftButtonDown="Tool_PreviewMouseDown" Click="Tool_Click" Tag="Pan" ToolTip="El Aracı (Kaydır)">
                            <Viewbox Width="19" Height="19">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="#CBD5E1" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 9,11 V 5.5 C 9,4.7 9.7,4 10.5,4 C 11.3,4 12,4.7 12,5.5 V 10 M 12,5.5 V 4.5 C 12,3.7 12.7,3 13.5,3 C 14.3,3 15,3.7 15,4.5 V 10 M 15,5.5 C 15,4.7 15.7,4 16.5,4 C 17.3,4 18,4.7 18,5.5 V 14 C 18,17.9 14.9,21 11,21 C 8.2,21 6.1,19.4 4.8,16.8 L 3.2,13.5 C 2.8,12.7 3.2,11.7 4,11.4 C 4.8,11.1 5.6,11.4 6,12.1 L 7,13.8 V 7.5 C 7,6.7 7.7,6 8.5,6 C 9.3,6 10,6.7 10,7.5"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Kement / Seçim -->
                        <Button x:Name="BtnLasso" Width="42" Height="42" Margin="0,3" Cursor="Hand" Click="BtnUnifiedSelect_Click" MouseRightButtonUp="BtnUnifiedSelect_RightClick" ToolTip="Seçim Aracı (Kement / Dikdörtgen)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SelectBtnBorder" CornerRadius="12" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" SnapsToDevicePixels="True">
                                        <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <!-- Kement Simgesi -->
                                            <Grid x:Name="IconSelectLasso" Visibility="Visible">
                                                <Path Data="M 10,2.5 C 14.8,2.5 17.5,5.2 17.5,8.8 C 17.5,12.4 14.2,15 9.5,15 C 5.2,15 2.5,12.4 2.5,8.8 C 2.5,5.2 5.4,2.5 10,2.5 Z" Stroke="#E2E8F0" StrokeThickness="1.7" StrokeDashArray="2.2 1.4" StrokeDashCap="Round"/>
                                                <Ellipse Width="4.5" Height="4.5" Fill="#818CF8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1.5,1.5"/>
                                            </Grid>
                                            <!-- Dikdortgen Simgesi -->
                                            <Grid x:Name="IconSelectRect" Visibility="Collapsed">
                                                <Rectangle Width="15" Height="12.5" RadiusX="2" RadiusY="2" Stroke="#E2E8F0" StrokeThickness="1.7" StrokeDashArray="2.2 1.4" StrokeDashCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Rectangle Width="4" Height="4" Fill="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,2"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SelectBtnBorder" Property="Background" Value="#1A2033"/>
                                        </Trigger>
                                        <Trigger Property="Tag" Value="Active">
                                            <Setter TargetName="SelectBtnBorder" Property="Background" Value="#1E243B"/>
                                            <Setter TargetName="SelectBtnBorder" Property="BorderBrush" Value="#6366F1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border Height="1" Width="24" Background="#25293A" Margin="0,3"/>

                        <!-- Kalem -->
                        <Button x:Name="BtnPen" Style="{StaticResource DockIconBtn}" Background="#252942" BorderBrush="#6366F1" PreviewMouseLeftButtonDown="Tool_PreviewMouseDown" Click="Tool_Click" Tag="Pen" ToolTip="Kalem">
                            <Grid Width="34" Height="34">
                                <Viewbox Width="20" Height="20" Margin="0,2,2,0">
                                    <Canvas Width="24" Height="24">
