                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Border>
        <!-- END SETTINGS OVERLAY -->
        <!-- STARTUP LOADING OVERLAY -->
        <Border x:Name="StartupLoadingOverlay" Grid.RowSpan="10" Grid.ColumnSpan="10" Panel.ZIndex="9999" Background="#07090F" Visibility="Visible">
            <Grid ClipToBounds="True">
                <!-- Arka Plan Ambiyans Isiklari -->
                <Ellipse Width="560" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-220,-180,0,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#226366F1" Offset="0.0"/>
                            <GradientStop Color="#006366F1" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="480" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="240,200,0,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#1838BDF8" Offset="0.0"/>
                            <GradientStop Color="#0038BDF8" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Merkez Cam Efektli Splash Karti -->
                <Border Width="420" Padding="36,34,36,30" CornerRadius="24" Background="#111422" BorderThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#456366F1" Offset="0.0"/>
                            <GradientStop Color="#182235" Offset="0.5"/>
                            <GradientStop Color="#4038BDF8" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="55" ShadowDepth="18" Opacity="0.82"/>
                    </Border.Effect>

                    <StackPanel HorizontalAlignment="Center">
                        <!-- Animasyonlu Logo ve Yorunge Halkasi -->
                        <Grid Width="86" Height="86" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <!-- Dis Sabit Halka -->
                            <Ellipse Width="86" Height="86" Stroke="#1D233A" StrokeThickness="2"/>

                            <!-- Donen Gradyan Yorunge Halkasi -->
                            <Ellipse Width="86" Height="86" StrokeThickness="2.5" StrokeDashArray="16 10" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#818CF8" Offset="0.0"/>
                                        <GradientStop Color="#38BDF8" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="StartupSpinnerRotate" Angle="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:3.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>

                            <!-- Ic Logo Kutusu -->
                            <Border Width="62" Height="62" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#384166" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1F2544" Offset="0.0"/>
                                        <GradientStop Color="#13172B" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#6366F1" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                                </Border.Effect>
                                <!-- Stilize Kalem Ucu ve Yıldız İkonu -->
                                <Grid>
                                    <Path Data="M 20,42 L 26,24 L 42,18 L 36,34 Z M 26,24 L 34,32" Stroke="#A5B4FC" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="5" Height="5" Fill="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,-14,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Baslik ve PRO Rozeti -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock Text="SarpNote" Foreground="#F8FAFC" FontSize="25" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border CornerRadius="6" Padding="7,2" Margin="9,2,0,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#4F46E5" Offset="0.0"/>
                                        <GradientStop Color="#0284C7" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="PRO" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="High-Precision PDF &amp; Stylus Studio" Foreground="#64748B" FontSize="11.5" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,0,0,26"/>

                        <!-- Durum Metni ve Canli Yuzde -->
                        <Grid Width="330" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtStartupStatus" Grid.Column="0" Text="Çalışma alanı başlatılıyor..." Foreground="#CBD5E1" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtStartupPercent" Grid.Column="1" Text="%15" Foreground="#818CF8" FontSize="12" FontWeight="Bold" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Gradyan Parlamali Ilerleme Cubugu -->
                        <Border Height="7" Width="330" Background="#171B2C" BorderBrush="#222842" BorderThickness="1" CornerRadius="3.5" ClipToBounds="True" HorizontalAlignment="Center">
                            <Border x:Name="StartupProgressFill" HorizontalAlignment="Left" Width="35" Height="7" CornerRadius="3.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#6366F1" Offset="0.0"/>
                                        <GradientStop Color="#818CF8" Offset="0.5"/>
                                        <GradientStop Color="#38BDF8" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#38BDF8" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
                                </Border.Effect>
                            </Border>
                        </Border>

                        <!-- Alt Donanim Etiketleri -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <TextBlock Text="200Hz V-Sync" Foreground="#475569" FontSize="10.5" FontWeight="SemiBold"/>
                            <TextBlock Text="  •  " Foreground="#334155" FontSize="10.5"/>
                            <TextBlock Text="Veikk Stylus Engine" Foreground="#475569" FontSize="10.5" FontWeight="SemiBold"/>
                            <TextBlock Text="  •  " Foreground="#334155" FontSize="10.5"/>
                            <TextBlock Text="144 DPI Render" Foreground="#475569" FontSize="10.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <!-- END STARTUP OVERLAY -->
    </Grid>
</Window>




























